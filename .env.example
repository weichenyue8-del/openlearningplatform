# Public Supabase project settings. Find these in the Supabase project dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin used in verification and password-recovery email links.
# Add the same origin to Supabase Auth URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secret used to sign short-lived password-recovery markers.
# Use at least 32 random characters. Never prefix this value with NEXT_PUBLIC_.
OPENAP_AUTH_RECOVERY_SECRET=

# Optional public links. Leave blank until the project has official destinations.
NEXT_PUBLIC_GITHUB_REPOSITORY_URL=
NEXT_PUBLIC_CONTACT_URL=
